[Unit]
Description=Owner-private Wine Production (read-only Notion shopping)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/lifeos-wine-private/current
ExecStart=/usr/bin/python3 -B server/wine_private.py --policy %h/.config/lifeos-wine-private/policy.json --dist dist --socket %t/lifeos-wine-private/app.sock
LoadCredential=notion-token:%h/.config/lifeos-wine-private/notion-token
LoadCredential=tailscale-oauth-id:%h/.config/lifeos-wine-private/tailscale-oauth-id
LoadCredential=tailscale-oauth-secret:%h/.config/lifeos-wine-private/tailscale-oauth-secret
RuntimeDirectory=lifeos-wine-private
RuntimeDirectoryMode=0700
UMask=0077
LimitCORE=0
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=128M
TasksMax=32
TimeoutStopSec=15

[Install]
WantedBy=default.target
